MARKETING_VERSION = 1.0.2
CURRENT_PROJECT_VERSION = 4
PRODUCT_BUNDLE_IDENTIFIER = com.toppotada.oyun

// Firebase konsolu → Proje ayarları → iOS uygulaması (com.toppotada.oyun) →
// GoogleService-Info.plist içindeki CLIENT_ID ve REVERSED_CLIENT_ID değerleri.
// Doldurulmadıkça "Google ile giriş" iOS'ta çalışmaz (uygulama çökmez, uyarı verir).
TP_GOOGLE_CLIENT_ID = BURAYA.apps.googleusercontent.com
TP_GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.BURAYA

// AdMob → Uygulamalar → Top Potada iOS. (Google'ın test kimlikleri 3940256099942544 yazılırsa reklam kapanır.)
TP_ADMOB_APP_ID = ca-app-pub-5425620592844224~9499014165
TP_AD_INTERSTITIAL = ca-app-pub-5425620592844224/3715224501
